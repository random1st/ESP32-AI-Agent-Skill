{
  "platform": "esp32",
  "variant": "esp32s3",
  "module": "ESP32-S3-WROOM-1-N16R8",
  "psram": "octal",
  "wifi_enabled": false,
  "board": "pregmate-main-a1",
  "notes": "Captured from main/LCD_Driver/ST7701S.h, main/I2C_Driver/I2C_Driver.h, main/Touch_Driver/GT911.h at PROJECT_VER 0.2.7. Buzzer and LCD reset hang off the TCA9554 expander, not native GPIO.",
  "pins": [
    {"gpio": 1,  "function": "LCD_SPI_MOSI", "protocol_bus": "spi", "device": "ST7701S", "direction": "output", "notes": "3-wire config bus, panel init only"},
    {"gpio": 2,  "function": "LCD_SPI_SCLK", "protocol_bus": "spi", "device": "ST7701S", "direction": "output"},
    {"gpio": 42, "function": "LCD_SPI_CS", "protocol_bus": "spi", "device": "ST7701S", "direction": "output"},
    {"gpio": 6,  "function": "LCD_BACKLIGHT_PWM", "protocol_bus": "pwm", "device": "backlight", "direction": "output", "speed_hz": 4000},
    {"gpio": 38, "function": "RGB_HSYNC", "protocol_bus": "gpio", "device": "ST7701S", "direction": "output"},
    {"gpio": 39, "function": "RGB_VSYNC", "protocol_bus": "gpio", "device": "ST7701S", "direction": "output"},
    {"gpio": 40, "function": "RGB_DE", "protocol_bus": "gpio", "device": "ST7701S", "direction": "output"},
    {"gpio": 41, "function": "RGB_PCLK", "protocol_bus": "gpio", "device": "ST7701S", "direction": "output", "speed_hz": 30000000},
    {"gpio": 5,  "function": "RGB_B0", "protocol_bus": "gpio", "device": "ST7701S", "direction": "output"},
    {"gpio": 45, "function": "RGB_B1", "protocol_bus": "gpio", "device": "ST7701S", "direction": "output", "notes": "Strapping pin (VDD_SPI); driven only after boot"},
    {"gpio": 48, "function": "RGB_B2", "protocol_bus": "gpio", "device": "ST7701S", "direction": "output"},
    {"gpio": 47, "function": "RGB_B3", "protocol_bus": "gpio", "device": "ST7701S", "direction": "output"},
    {"gpio": 21, "function": "RGB_B4", "protocol_bus": "gpio", "device": "ST7701S", "direction": "output"},
    {"gpio": 14, "function": "RGB_G0", "protocol_bus": "gpio", "device": "ST7701S", "direction": "output"},
    {"gpio": 13, "function": "RGB_G1", "protocol_bus": "gpio", "device": "ST7701S", "direction": "output"},
    {"gpio": 12, "function": "RGB_G2", "protocol_bus": "gpio", "device": "ST7701S", "direction": "output"},
    {"gpio": 11, "function": "RGB_G3", "protocol_bus": "gpio", "device": "ST7701S", "direction": "output"},
    {"gpio": 10, "function": "RGB_G4", "protocol_bus": "gpio", "device": "ST7701S", "direction": "output"},
    {"gpio": 9,  "function": "RGB_G5", "protocol_bus": "gpio", "device": "ST7701S", "direction": "output"},
    {"gpio": 46, "function": "RGB_R0", "protocol_bus": "gpio", "device": "ST7701S", "direction": "output", "notes": "Strapping pin; output-capable on S3 (unlike S2)"},
    {"gpio": 3,  "function": "RGB_R1", "protocol_bus": "gpio", "device": "ST7701S", "direction": "output", "notes": "Strapping pin (JTAG source select)"},
    {"gpio": 8,  "function": "RGB_R2", "protocol_bus": "gpio", "device": "ST7701S", "direction": "output"},
    {"gpio": 18, "function": "RGB_R3", "protocol_bus": "gpio", "device": "ST7701S", "direction": "output"},
    {"gpio": 17, "function": "RGB_R4", "protocol_bus": "gpio", "device": "ST7701S", "direction": "output"},
    {"gpio": 15, "function": "I2C_SDA", "protocol_bus": "i2c", "device": "GT911+TCA9554", "direction": "inout", "pull": "external_up", "speed_hz": 400000},
    {"gpio": 7,  "function": "I2C_SCL", "protocol_bus": "i2c", "device": "GT911+TCA9554", "direction": "output", "pull": "external_up", "speed_hz": 400000},
    {"gpio": 16, "function": "TOUCH_INT", "protocol_bus": "gpio", "device": "GT911", "direction": "input", "pull": "external_up"}
  ]
